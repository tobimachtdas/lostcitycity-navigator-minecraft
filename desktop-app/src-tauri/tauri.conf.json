{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lost City Finder",
  "version": "0.8.3",
  "identifier": "de.tobimachtdas.lostcityfinder",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/lcf-backend"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "tobimachtdas",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
